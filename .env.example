PORT=3000
# Record the git commit or deployment build identifier for reproducible runs.
APP_REVISION=local

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=trading_assistant
## `true` is convenient only for a disposable local database. Production and
## long-lived Demo databases must use migrations instead.
DB_SYNCHRONIZE=false

# Active forward-Demo strategy. This does not authorize real exchange orders.
ACTIVE_STRATEGY_VERSION=ccxt-ema50-rsi14-v1

# Leave blank while all strategies are research-only. To authorize an alert or
# a Demo experiment, this must exactly equal ACTIVE_STRATEGY_VERSION after the
# documented review has been completed.
APPROVED_STRATEGY_VERSION=

# Global kill-switch. Keep false until one explicitly approved strategy has
# passed the documented research gates and the operator deliberately enables a
# forward Demo run.
DEMO_TRADING_ENABLED=false

# Explicitly labelled engineering trial; it never places a real order.
EXPLORATORY_DEMO_ENABLED=true
EXPLORATORY_DEMO_START_AT=2026-09-26T08:36:27.000Z

# Engineering Demo records hypothetical next-open
# Demo entries and outcomes in the local database, with Telegram notifications.

# Spot Demo risk guard: do not simulate more than this many concurrent BUYs.
MAX_DEMO_OPEN_POSITIONS=2
DEMO_STARTING_BALANCE_EUR=1000
# Maximum EUR committed to one position. The risk model may choose less.
DEMO_POSITION_SIZE_EUR=100
# Maximum planned loss as a fraction of currently available Demo equity.
DEMO_RISK_PER_TRADE_PERCENT=0.01
# Conservative total-cost model used by both historical and Demo evaluation.
BACKTESTING_FEE_RATE=0.0005
BACKTESTING_SLIPPAGE_RATE=0.0005

# The latest year stays out of ordinary research backtests. Only a deliberate
# final research-server run with ?includeHoldout=true may evaluate it before Demo activation.
BACKTEST_HOLDOUT_DAYS=365


TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Pause entry admission without suspending existing position exits.
DEMO_ENTRIES_PAUSED=false


CCXT_ASSISTANT_ENABLED=false
CCXT_ASSISTANT_INTERVAL_MS=60000
